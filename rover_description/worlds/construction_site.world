
<?xml version="1.0"?>
<sdf version="1.6">
  <world name="construction_site">

    <!-- 1. Physics settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 2. Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 3. Ground plane -->
    <model name="site_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>12 10 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12 10 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.1 0 0 0</pose>
    </model>

    <!-- 4. Perimeter walls -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.2 10 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-6 0 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.2 10 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 5. Internal wall with a 2 m doorway -->
    <model name="partition_left">
      <static>true</static>
      <pose>-2.5 1.5 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>3 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.2 2</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="partition_right">
      <static>true</static>
      <pose>2.5 1.5 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>3 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.2 2</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 6. Pillars -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-3 -2 1 0 0 0</pose>
      <link name="pillar_link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>3 -2.5 1 0 0 0</pose>
      <link name="pillar_link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 7. Boxes / material obstacles -->
    <model name="material_stack">
      <static>true</static>
      <pose>-1 -3 0.4 0 0 0</pose>
      <link name="stack_link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.3 0.12 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="supply_box">
      <static>true</static>
      <pose>2 0 0.3 0 0 0</pose>
      <link name="box_link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.2 0.4 0.75 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
